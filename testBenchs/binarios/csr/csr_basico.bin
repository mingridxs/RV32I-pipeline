// Teste das instrucoes CSR (parte 1) - resultados esperados nos comentarios
// x1=0x100 x2=0 x3=0x100 x4=0x104 x5=0x1808 x6=0x1808 x7=0x1800 x8=0x104 x9=0 x10=7
// 0x00  addi   x1, x0, 0x100      x1 = 0x100
000100000000_00000_000_00001_0010011
// 0x04  csrrw  x2, mtvec, x1      x2 = 0 (antigo), mtvec = 0x100
001100000101_00001_001_00010_1110011
// 0x08  csrr   x3, mtvec          x3 = 0x100
001100000101_00000_010_00011_1110011
// 0x0c  addi   x4, x3, 4          forwarding do csrr: x4 = 0x104
000000000100_00011_000_00100_0010011
// 0x10  csrrsi x0, mstatus, 8     liga MIE
001100000000_01000_110_00000_1110011
// 0x14  csrr   x5, mstatus        x5 = 0x1808
001100000000_00000_010_00101_1110011
// 0x18  csrw   mscratch, x4       mscratch = 0x104
001101000000_00100_001_00000_1110011
// 0x1c  csrrci x6, mstatus, 8     x6 = 0x1808 (antigo), desliga MIE
001100000000_01000_111_00110_1110011
// 0x20  csrr   x7, mstatus        x7 = 0x1800
001100000000_00000_010_00111_1110011
// 0x24  csrr   x8, mscratch       x8 = 0x104
001101000000_00000_010_01000_1110011
// 0x28  beq    x8, x4, +8         branch em ID depende do csrr: stall + forwarding, desvia
000000000100_01000_000_01000_1100011
// 0x2c  addi   x9, x0, 1          NAO deve executar: x9 continua 0
000000000001_00000_000_01001_0010011
// 0x30  addi   x10, x0, 7         x10 = 7
000000000111_00000_000_01010_0010011
// 0x34  jal    x0, 0              fim: laço infinito
000000000000_00000_000_00000_1101111
